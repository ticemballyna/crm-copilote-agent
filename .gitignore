# Créer le fichier .gitignore
@"
# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environnement
.env
.env.local
.env.*.local

# Base de données
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/*.db
prisma/*.sqlite
prisma/dev.db
prisma/dev.db-journal

# Prisma
prisma/migrations/*.sql
!prisma/migrations/migration_lock.toml

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.iml
*.swp
*.swo

# Build
dist/
build/
*.tsbuildinfo

# Tests
coverage/
.nyc_output/

# Temp
tmp/
temp/
*.tmp
"@ | Out-File -FilePath .gitignore -Encoding utf8