# --- Base de données SQLite (fichier local, zéro config) ---
DATABASE_URL="file:./dev.db"

# --- OpenRouter (fournisseur LLM) ---
# Clé à récupérer sur https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modèle utilisé pour toutes les étapes du pipeline IA
# Options recommandées sur OpenRouter :
#   - openai/gpt-4o-mini          (rapide, peu coûteux, fiable en JSON)
#   - anthropic/claude-3.5-haiku  (rapide, peu coûteux)
#   - meta-llama/llama-3.3-70b-instruct:free (gratuit, moins fiable en JSON)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

PORT=8000
